{
  "name": "sentinel402",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Intent-bound payment authorization, sandbox console and reproducible research suite",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "node src/server.mjs --demo",
    "start": "node src/server.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "benchmark": "node research/run.mjs",
    "benchmark:systems": "node research/systems.mjs",
    "check": "node scripts/check.mjs",
    "demo:agent": "node examples/agent.mjs",
    "demo:judge": "node scripts/demo.mjs",
    "demo:llm": "node examples/live-agent.mjs",
    "benchmark:llm": "node research/live-run.mjs",
    "research:experiments": "node research/experiments.mjs",
    "research:stress": "node research/stress.mjs",
    "research:randomized": "node research/randomized.mjs",
    "research:llm:plan": "node research/live-run.mjs --expanded --dry-run",
    "research:workflow": "node research/workflow-run.mjs",
    "research:adaptive": "node research/workflow-search.mjs",
    "research:crashes": "node research/crash-run.mjs",
    "research:separation": "node research/separation.mjs",
    "demo:devnet": "npm --prefix integrations/solana run demo",
    "validator:local": "node scripts/local-validator.mjs",
    "demo:local": "node integrations/solana/demo.mjs --local",
    "research:local": "node integrations/solana/local-run.mjs"
  }
}
