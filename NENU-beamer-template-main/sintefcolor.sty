\definecolor{hustgold}{RGB}{248,190,48}
\definecolor{hustgray}{RGB}{80,80,80}
\definecolor{hustlightgray}{RGB}{242,242,242}

\colorlet{maincolor}{hustred}

% Legacy names retained so existing slides automatically use the HUST palette.
\colorlet{sintefgrey}{hustlightgray}
\colorlet{sintefgray}{hustlightgray}
\colorlet{sinteflightgreen}{hustlightred}
\colorlet{sintefgreen}{hustmediumred}
\colorlet{sintefdarkgreen}{hustdarkred}
\colorlet{sintefyellow}{hustgold}
\colorlet{sintefblue}{hustred}
\colorlet{sinteflilla}{hustdarkred}
\colorlet{sintefcyan}{hustmediumred}
\colorlet{sintefmagenta}{hustdarkred}
\colorlet{sinteflightgrey}{hustlightgray}
\colorlet{sinteflightgray}{hustlightgray}
