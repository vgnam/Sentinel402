\ProvidesPackage{sintefcolor}[2026/07/29 HUST colour palette]

\RequirePackage{xcolor}

% Hanoi University of Science and Technology palette.
\definecolor{hustred}{RGB}{190,35,45}
\definecolor{hustdarkred}{RGB}{126,18,29}
\definecolor{hustmediumred}{RGB}{219,65,72}
