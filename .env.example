# Copy to .env. Server/LLM CLI load .env; shell variables take precedence.
SENTINEL_CONTROL_KEY=replace-with-at-least-32-random-characters
SENTINEL_DB=data/sentinel.sqlite
PORT=4020
HOST=127.0.0.1

OPENAI_API_KEY=your-provider-api-key
OPENAI_BASE_URL=https://api.mintrouter.ai/v1
OPENAI_MODEL=glm-5.3
OPENAI_REASONING_EFFORT=low
